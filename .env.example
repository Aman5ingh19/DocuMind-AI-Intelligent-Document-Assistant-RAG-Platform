# ============================================================
# Environment Variable Template
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to Git. It is listed in .gitignore.
# ============================================================

# ─────────────────────────────────────────────────────────────
# MySQL / Database
# ─────────────────────────────────────────────────────────────
# For local development (used by docker-compose mysql service):
MYSQL_ROOT_PASSWORD=change_me_root_password
MYSQL_DATABASE=docassistant
MYSQL_USER=docuser
MYSQL_PASSWORD=change_me_db_password

# For Aiven MySQL (production), override ConnectionStrings in appsettings.Production.json
# or pass as: ConnectionStrings__DefaultConnection in docker-compose environment

# ─────────────────────────────────────────────────────────────
# JWT Authentication
# ─────────────────────────────────────────────────────────────
# REQUIRED: generate a long random secret (e.g. openssl rand -hex 32)
JWT_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
JWT_ISSUER=DocAssistant
JWT_AUDIENCE=DocAssistant
JWT_EXPIRY_MINUTES=60

# ─────────────────────────────────────────────────────────────
# Internal Service Security
# ─────────────────────────────────────────────────────────────
# REQUIRED: shared secret between .NET API and Python AI service
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
INTERNAL_API_KEY=REPLACE_WITH_A_LONG_RANDOM_INTERNAL_SECRET

# ─────────────────────────────────────────────────────────────
# LLM Provider
# ─────────────────────────────────────────────────────────────
# Valid values: mock | openai | groq
# Use "mock" for development (zero cost, no API key needed)
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini

# Uncomment the key for your chosen provider:
# OPENAI_API_KEY=sk-...
# GROQ_API_KEY=gsk_...
# GEMINI_API_KEY=AIzaSy...

# ─────────────────────────────────────────────────────────────
# Embedding Provider
# ─────────────────────────────────────────────────────────────
# Valid values: mock | openai | sentence-transformers
# Use "mock" for development (zero cost)
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=text-embedding-3-small

# ─────────────────────────────────────────────────────────────
# Document Processing
# ─────────────────────────────────────────────────────────────
CHUNK_SIZE_TOKENS=500
CHUNK_OVERLAP_TOKENS=100

# ─────────────────────────────────────────────────────────────
# File Upload Limits
# ─────────────────────────────────────────────────────────────
# 25 MB in bytes
MAX_FILE_SIZE_BYTES=26214400

# ─────────────────────────────────────────────────────────────
# ASP.NET Core Environment
# ─────────────────────────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=Development
