# ─────────────────────────────────────────────
# .gitignore for the AI-Powered Document Assistant
# ─────────────────────────────────────────────

# ─── Secrets (NEVER COMMIT) ───────────────────
.env
*.env.local
*.env.production

# ─── Python ───────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
venv/
.venv/
env/
*.egg-info/
dist/
build/
.pytest_cache/
.coverage
htmlcov/
*.log
ai_service/data/

# ─── Node / Angular ───────────────────────────
node_modules/
frontend/dist/
frontend/.angular/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─── .NET / C# ────────────────────────────────
backend/src/**/bin/
backend/src/**/obj/
backend/tests/**/bin/
backend/tests/**/obj/
*.user
.vs/
*.suo
TestResults/

# ─── Data (runtime) ───────────────────────────
data/
uploads/
chroma_db/

# ─── IDEs ────────────────────────────────────
.idea/
.vscode/settings.json
*.swp
*.swo
Thumbs.db
.DS_Store
