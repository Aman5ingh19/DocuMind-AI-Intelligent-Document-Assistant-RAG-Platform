{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Port=3306;Database=docassistant;User=doc_user;Password=doc_password;CharSet=utf8mb4;"
  },
  "JwtSettings": {
    "SecretKey": "ThisIsAStrongSecretKeyForDevelopmentOnlyPleaseChangeInProduction123!",
    "Issuer": "DocumentAssistantApi",
    "Audience": "DocumentAssistantFrontend",
    "ExpiryMinutes": 120
  },
  "AiService": {
    "BaseUrl": "http://localhost:8000",
    "InternalApiKey": "dev-internal-secret-key-change-in-production"
  },
  "Storage": {
    "LocalPath": "data/documents"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200",
      "http://localhost:4201"
    ]
  }
}
